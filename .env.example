# Settings for Terrola. This file holds names only, never real values.
#
# Local use: copy it to .env.local and fill in what you need. Never commit a
# filled in copy. On a host such as Vercel, set these in the project settings
# and keep no file at all.
#
# The names below are the ones the app code reads. lib/mode.ts holds the mode
# rules and the list of live settings.

# --- Mode -------------------------------------------------------------------
# Empty, 0, false or off: live mode (real data, one shared password).
# 1: the read only demo on made up data. It refuses to start when any of the
#    five live settings below is set.
# writable: a demo for the dev server and tests only. Saving does not work in
#    it yet (see README.md).
DEMO_MODE=

# --- Map (every mode) -------------------------------------------------------
# A Mapbox public token. The browser sees it, so restrict it to your site's
# address in your Mapbox account.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Live mode only: leave all five empty for a demo ------------------------
# The address of your Supabase project. The fifth live setting is the older
# name NEXT_PUBLIC_SUPABASE_URL, read only when SUPABASE_URL is not defined at
# all. Prefer SUPABASE_URL and do not define the other. If you do use the
# older name, delete the line below.
SUPABASE_URL=

# The Supabase service role key. Server only. It bypasses row level security,
# so treat it like a password.
SUPABASE_SERVICE_KEY=

# A bcrypt hash of the shared password, written in base64. Use base64 because
# env loaders read the "$" in a raw hash as a variable and break it. A raw
# hash is also accepted where nothing rewrites it. Passwords over 72 bytes are
# refused at login.
SITE_PASSWORD_HASH=

# The key that signs the session cookie: 32 or more random characters.
# Nothing else is used in its place when it is missing or short.
SESSION_SECRET=

# --- Live mode, scheduled ping ----------------------------------------------
# The secret a scheduler sends to GET /api/keep-alive as
# "Authorization: Bearer <value>". 16 or more characters.
CRON_SECRET=

# --- Optional ---------------------------------------------------------------
# Who writes in this map: up to 8 ids, comma separated, for example
# alpha,beta. An id is lower case letters, digits, "-" and "_", starts with a
# letter or digit and has at most 32 characters. Empty means
# member-1,member-2. An id is a label, not a login.
MEMBERS=

# 1 shows tiny blurred placeholders while photos load.
NEXT_PUBLIC_LQIP_ENABLED=

# --- Local browser tests only (tests/local, tests/e2e) ----------------------
# Remove the "# " in front of a line to use it.
# The address of the running instance to test. Not defined means
# http://localhost:3000.
# E2E_BASE=http://localhost:3000

# The shared password in plain text, so the tests can log in. Never set this
# on a host.
# SITE_PASSWORD=
