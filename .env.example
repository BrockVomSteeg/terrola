# Copy to .env.local and fill in. Never commit real values.

# Mapbox public access token (ships to the browser).
NEXT_PUBLIC_MAPBOX_TOKEN=
# Supabase project URL.
SUPABASE_URL=
# Supabase service role key (server only, bypasses row level security).
SUPABASE_SERVICE_KEY=
# bcrypt hash of the site password (base64 encoding allowed).
SITE_PASSWORD_HASH=
# HMAC key for session tokens, at least 16 characters.
SESSION_SECRET=
# Comma separated member ids, for example: member1,member2
MEMBERS=
