{
  "ci": {
    "collect": {
      "url": ["https://terrola.vercel.app/map"],
      "numberOfRuns": 5,
      "settings": {
        "onlyCategories": ["performance", "accessibility", "best-practices"],
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
        "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
        "categories:performance": ["warn", { "minScore": 0.7, "aggregationMethod": "median" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-report"
    }
  }
}
